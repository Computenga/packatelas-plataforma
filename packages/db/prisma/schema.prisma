// Modelo de datos de la Plataforma Packatelas.
// Los IDs entre corchetes ([A01], [F02]…) remiten al Sheet de requerimientos.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Usuarios y sesiones [A13] ─────────────────────────

enum Role {
  ADMIN
  OPERADOR
  DESPACHADOR
  REPARTIDOR
  CLIENTE
  EMPLEADO
  MECANICO
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  email        String?   @unique
  name         String
  passwordHash String
  role         Role
  active       Boolean   @default(true)
  totpSecret   String? // 2FA para administradores [P09], cifrado
  totpLastStep Int? // último intervalo usado: el mismo código no sirve dos veces
  clientId     String? // solo para rol CLIENTE
  client       Client?   @relation(fields: [clientId], references: [id])
  driver       Driver?
  employee     Employee?
  sessions     Session[]
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs         AuditLog[]
  orderEvents       OrderEvent[]
  pushSubscriptions PushSubscription[]

  @@index([clientId])
}

model Session {
  id        String   @id // hash SHA-256 del token de la cookie
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ───────────────────────── Clientes [A15, C01] ─────────────────────────

enum CreditMode {
  PREPAID // si debe, se bloquea la recolección
  WEEKLY_CREDIT // acumula en la semana; el día de corte amanece bloqueado hasta liquidar
}

enum TariffMode {
  FIXED // Tarifa fija para todas las órdenes
  FLEX_DYNAMIC_PLUS_FIXED // Flex dinámica + externos con tarifa fija
}

model Client {
  id               String  @id @default(cuid())
  publicId         String  @unique // p. ej. cmx00125
  name             String
  contactName      String?
  phone            String?
  email            String?
  active           Boolean @default(true)
  paymentReference String  @unique // referencia para transferencias [C09]

  // Datos fiscales [C01, I10]
  rfc         String?
  legalName   String?
  taxRegime   String?
  taxZip      String?
  cfdiUse     String?
  autoInvoice Boolean @default(false)

  // Tarifas y cobro [F01, F07]
  tariffMode        TariffMode @default(FIXED)
  tariffAmount      Decimal    @default(0) @db.Decimal(12, 2)
  chargingEnabled   Boolean    @default(true)
  creditMode        CreditMode @default(PREPAID) // [F08]
  creditLimit       Decimal?   @db.Decimal(12, 2) // saldo máximo antes de bloquear recolecciones
  pickupExemptUntil DateTime?
  pickupExemptNote  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  branches   Branch[]
  mlAccounts MlAccount[]
  orders     Order[]
  pickups    Pickup[]
  ledger     LedgerEntry[]
  payments   Payment[]
  invoices   Invoice[]
  apiKeys    ApiKey[]
  webhook    WebhookEndpoint?
  stores     StoreConnector[]
}

model Branch {
  id             String   @id @default(cuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id])
  name           String
  address        String
  lat            Float?
  lng            Float?
  phone          String?
  active         Boolean  @default(true)
  autoPickup     Boolean  @default(false) // recolección automática [A06]
  autoPickupDays Int[]    @default([]) // 1=lunes … 7=domingo
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  mlRoutes MlAccountRoute[]
  orders   Order[]
  pickups  Pickup[]

  @@index([clientId])
}

// ───────────────────────── MercadoLibre [I01, I02, A02, A05] ─────────────────────────

enum MlAccountStatus {
  ACTIVE
  TOKEN_EXPIRED
  REVOKED
  DISABLED
}

model MlAccount {
  id              String          @id @default(cuid())
  mlUserId        BigInt          @unique // seller_id de MercadoLibre
  nickname        String
  clientId        String
  client          Client          @relation(fields: [clientId], references: [id])
  status          MlAccountStatus @default(ACTIVE)
  accessTokenEnc  String? // cifrado
  refreshTokenEnc String? // cifrado
  tokenExpiresAt  DateTime?
  connectedAt     DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  routes MlAccountRoute[]
  orders Order[]

  @@index([clientId])
}

// Enrutamiento cuenta ML → sucursal(es) del cliente [A02]
model MlAccountRoute {
  mlAccountId String
  mlAccount   MlAccount @relation(fields: [mlAccountId], references: [id], onDelete: Cascade)
  branchId    String
  branch      Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@id([mlAccountId, branchId])
}

// ───────────────────────── Repartidores [A14, A05, R10] ─────────────────────────

model Driver {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id])
  phone          String?
  vehicleType    String? // moto, auto…
  plate          String?
  active         Boolean   @default(true)
  onDuty         Boolean   @default(false)
  shiftStartedAt DateTime?
  lastLat        Float?
  lastLng        Float?
  lastLocationAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  flexIdentities FlexIdentity[]
  orders         Order[]
  routes         Route[]
  pickups        Pickup[]
  locations      LocationPing[]
}

// Vínculo driver Flex de ML ↔ repartidor para asignar al escanear [A05]
model FlexIdentity {
  id             String   @id @default(cuid())
  flexDriverId   BigInt   @unique
  driverId       String
  driver         Driver   @relation(fields: [driverId], references: [id])
  lastShipmentId BigInt?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@index([driverId])
}

model LocationPing {
  id         BigInt   @id @default(autoincrement())
  driverId   String
  driver     Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  lat        Float
  lng        Float
  accuracy   Float?
  speed      Float?
  battery    Float?
  recordedAt DateTime // hora del dispositivo
  receivedAt DateTime @default(now())

  @@index([driverId, recordedAt])
}

// ───────────────────────── Pedidos [A01, A03, A09–A12] ─────────────────────────

enum OrderSource {
  ML_FLEX
  ML_OTHER
  MANUAL
  EXTERNAL_SCAN // paquete externo escaneado por el repartidor [R14]
  IMPORT
  API // creado por el sistema del cliente [I08]
}

enum OrderStatus {
  CREATED // escaneado o registrado
  ASSIGNED
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RESCHEDULED
  RETURNING // va de regreso al almacén
  RETURNED_TO_WAREHOUSE
  RETURNED_TO_SELLER
  CANCELLED
}

model Order {
  id           String      @id @default(cuid())
  code         String      @unique // ML-48323149259 o PK-000123
  source       OrderSource
  status       OrderStatus @default(CREATED)
  clientId     String
  client       Client      @relation(fields: [clientId], references: [id])
  branchId     String?
  branch       Branch?     @relation(fields: [branchId], references: [id])
  mlAccountId  String?
  mlAccount    MlAccount?  @relation(fields: [mlAccountId], references: [id])
  mlShipmentId BigInt?     @unique
  mlOrderId    BigInt?
  mlPackId     BigInt?
  mlStatus     String?
  mlSubstatus  String?

  recipientName  String?
  recipientPhone String?
  addressLine    String
  neighborhood   String?
  city           String?
  state          String?
  zip            String?
  lat            Float?
  lng            Float?
  instructions   String?
  itemsSummary   String?
  externalRef    String? // referencia del cliente al crear por API [I08]
  declaredValue  Decimal? @db.Decimal(12, 2)

  requestedDeliveryAt DateTime?
  deliveredAt         DateTime?
  attempts            Int       @default(0)

  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events     OrderEvent[]
  evidence   Evidence[]
  routeStops RouteStop[]
  return     ReturnCustody?
  ledger     LedgerEntry[]

  @@unique([clientId, externalRef])
  @@index([clientId, createdAt])
  @@index([driverId, status])
  @@index([status, createdAt])
}

enum EventSource {
  SCAN
  DRIVER_APP
  ADMIN
  CLIENT
  ML_SYNC
  FLEX_HANDSHAKE
  IMPORT
  SYSTEM
}

// Historia completa del pedido; el estado actual se deriva de aquí.
model OrderEvent {
  id            String       @id @default(cuid())
  orderId       String
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type          String // created, assigned, scanned_loaded, delivered, failed, ml_synced…
  fromStatus    OrderStatus?
  toStatus      OrderStatus?
  source        EventSource
  actorUserId   String?
  actor         User?        @relation(fields: [actorUserId], references: [id])
  lat           Float?
  lng           Float?
  note          String?
  data          Json?
  clientEventId String?      @unique // idempotencia de la cola sin conexión [R11]
  occurredAt    DateTime // hora real (del dispositivo si viene sin conexión)
  recordedAt    DateTime     @default(now())

  evidence Evidence[]

  @@index([orderId, occurredAt])
}

enum EvidenceKind {
  PHOTO
  SIGNATURE
}

model Evidence {
  id           String       @id @default(cuid())
  orderId      String
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  eventId      String?
  event        OrderEvent?  @relation(fields: [eventId], references: [id])
  kind         EvidenceKind
  storageKey   String
  receiverName String?
  createdAt    DateTime     @default(now())

  @@index([orderId])
}

// ───────────────────────── Rutas [A08, R02] ─────────────────────────

enum RouteStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
}

model Route {
  id             String      @id @default(cuid())
  driverId       String
  driver         Driver      @relation(fields: [driverId], references: [id])
  date           DateTime    @db.Date
  status         RouteStatus @default(PLANNED)
  optimizedAt    DateTime?
  totalDistanceM Int?
  totalDurationS Int?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  stops RouteStop[]

  @@index([driverId, date])
}

model RouteStop {
  id          String    @id @default(cuid())
  routeId     String
  route       Route     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  sequence    Int
  orderId     String?
  order       Order?    @relation(fields: [orderId], references: [id])
  pickupId    String?
  pickup      Pickup?   @relation(fields: [pickupId], references: [id])
  eta         DateTime?
  completedAt DateTime?

  @@index([routeId, sequence])
}

// ───────────────────────── Recolecciones [A06, R09, C05] ─────────────────────────

enum PickupStatus {
  SCHEDULED
  ASSIGNED
  COLLECTED
  FAILED
  CANCELLED
  BLOCKED // bloqueada por adeudo [F07]
}

model Pickup {
  id             String       @id @default(cuid())
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id])
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id])
  scheduledFor   DateTime     @db.Date
  status         PickupStatus @default(SCHEDULED)
  automatic      Boolean      @default(false)
  driverId       String?
  driver         Driver?      @relation(fields: [driverId], references: [id])
  expectedCount  Int?
  collectedCount Int?
  note           String?
  collectedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  routeStops RouteStop[]

  @@index([scheduledFor, status])
  @@index([clientId])
}

// ───────────────────────── Devoluciones [A10, R13, C07] ─────────────────────────

enum ReturnStatus {
  PENDING_RECEIPT // el repartidor aún no lo entrega al almacén
  IN_WAREHOUSE
  RETURNED_TO_SELLER
}

model ReturnCustody {
  id                String       @id @default(cuid())
  orderId           String       @unique
  order             Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status            ReturnStatus @default(PENDING_RECEIPT)
  receivedAt        DateTime?
  receivedById      String?
  returnedAt        DateTime?
  returnedById      String?
  returnEvidenceKey String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([status])
}

// ───────────────────────── Dinero: libro mayor [F01–F11] ─────────────────────────
// Montos con signo: cargos positivos (aumentan la deuda), abonos negativos.
// Saldo del cliente = SUM(amount). Nunca se edita ni se borra un movimiento.

enum LedgerType {
  CHARGE // cargo por envío
  PAYMENT // abono (transferencia, Mercado Pago, manual)
  FEE // comisión por pago con tarjeta [I09]
  ADJUSTMENT // corrección
}

model LedgerEntry {
  id          String     @id @default(cuid())
  clientId    String
  client      Client     @relation(fields: [clientId], references: [id])
  type        LedgerType
  amount      Decimal    @db.Decimal(12, 2)
  description String
  orderId     String?
  order       Order?     @relation(fields: [orderId], references: [id])
  paymentId   String?
  payment     Payment?   @relation(fields: [paymentId], references: [id])
  createdById String?
  createdAt   DateTime   @default(now())

  @@unique([orderId, type]) // un solo cargo por pedido aunque se escanee dos veces
  @@index([clientId, createdAt])
}

enum PaymentMethod {
  TRANSFER
  MERCADOPAGO
  CASH
  OTHER
}

enum PaymentSource {
  GMAIL
  MERCADOPAGO
  MANUAL
}

enum PaymentStatus {
  UNIDENTIFIED // no se encontró cliente [F05]
  APPLIED
  REJECTED
}

model Payment {
  id          String        @id @default(cuid())
  clientId    String?
  client      Client?       @relation(fields: [clientId], references: [id])
  method      PaymentMethod
  source      PaymentSource
  status      PaymentStatus
  amount      Decimal       @db.Decimal(12, 2)
  fee         Decimal       @default(0) @db.Decimal(12, 2)
  reference   String?
  trackingKey String?       @unique // clave de rastreo SPEI / id de Mercado Pago: evita duplicados
  senderName  String?
  receivedAt  DateTime
  externalId  String?       @unique // id del correo o del pago externo
  note        String?
  appliedById String?
  createdAt   DateTime      @default(now())

  ledger   LedgerEntry[]
  invoices Invoice[]

  @@index([status, receivedAt])
}

enum InvoiceStatus {
  PENDING
  ISSUED
  FAILED
  CANCELLED
}

model Invoice {
  id        String        @id @default(cuid())
  clientId  String
  client    Client        @relation(fields: [clientId], references: [id])
  paymentId String?
  payment   Payment?      @relation(fields: [paymentId], references: [id])
  status    InvoiceStatus @default(PENDING)
  uuid      String?       @unique // folio fiscal
  series    String?
  folio     String?
  total     Decimal       @db.Decimal(12, 2)
  pdfKey    String?
  xmlKey    String?
  error     String?
  issuedAt  DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([clientId])
}

// ───────────────────────── Auditoría y ajustes [A19] ─────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id])
  action      String // payment.manual, client.tariff_updated, pickup.exempted…
  entity      String
  entityId    String?
  summary     String
  data        Json?
  createdAt   DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

enum SignupStatus {
  PENDING
  APPROVED
  REJECTED
}

// Solicitud de registro de un cliente nuevo desde el formulario público [C01].
// Al aprobarla se crean el cliente (con su ID cmx/emx), la sucursal y el usuario.
model ClientSignup {
  id              String       @id @default(cuid())
  status          SignupStatus @default(PENDING)
  businessName    String
  contactName     String
  phone           String
  email           String
  zone            String // cmx | emx
  pickupAddress   String
  pickupReference String?
  monthlyVolume   String?
  salesChannels   String? // MercadoLibre, Tiendanube, redes…
  rfc             String?
  legalName       String?
  taxRegime       String?
  taxZip          String?
  cfdiUse         String?
  username        String
  passwordHash    String
  termsAcceptedAt DateTime
  ip              String?
  clientId        String?      @unique
  reviewedById    String?
  reviewedAt      DateTime?
  reviewNote      String?
  createdAt       DateTime     @default(now())

  @@index([status, createdAt])
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED // sin credenciales o aviso desactivado al momento de enviarlo
}

// Bitácora de avisos por WhatsApp [C11, C12, F10, I04]. Cada aviso se guarda antes de enviarse;
// dedupeKey evita mandar dos veces el mismo aviso (p. ej. reintentos de la cola del repartidor).
model Notification {
  id         String             @id @default(cuid())
  event      String // en_camino, entregado, no_entregado, recoleccion_bloqueada, recordatorio_pago
  channel    String             @default("whatsapp")
  to         String // teléfono con lada 52…
  template   String // nombre de la plantilla aprobada en Meta
  params     Json // valores de la plantilla, en orden
  preview    String // texto aproximado de lo que recibe la persona
  status     NotificationStatus @default(PENDING)
  error      String?
  attempts   Int                @default(0)
  dedupeKey  String             @unique
  orderId    String?
  clientId   String?
  externalId String? // id del mensaje en WhatsApp
  createdAt  DateTime           @default(now())
  sentAt     DateTime?

  @@index([status, createdAt])
  @@index([clientId])
}

// ── Fase 3: personal y asistencia [A22, A23, A25] ──────────────────────────
// Independiente de los sistemas actuales (Sheet del portal, ZKTeco, RH local): aquí solo se
// importa; nada se escribe de regreso.

enum EmployeeStatus {
  ACTIVO
  BAJA
}

// Base maestra de empleados (mismos campos que la pestaña "Personal").
model Employee {
  id            String         @id @default(cuid())
  employeeNo    Int            @unique // ID del ZKTeco; en flotilla U-<no>
  name          String
  rfc           String?
  curp          String?
  nss           String?
  position      String?
  area          String?
  kind          String? // repartidor, oficina, bodega, mecánico…
  status        EmployeeStatus @default(ACTIVO)
  hireDate      DateTime?      @db.Date
  endDate       DateTime?      @db.Date
  dailySalary   Decimal?       @db.Decimal(10, 2)
  clabe         String?
  bank          String?
  phone         String?
  email         String?
  entryTime     String? // "10:00"
  workdays      Int[]          @default([1, 2, 3, 4, 5, 6]) // 1 = lunes … 7 = domingo
  lunchMinutes  Int            @default(60)
  punchesPerDay Int            @default(2) // 2 = entrada/salida, 4 = con comida
  motoType      String?
  address       String?
  emergency     Json?
  notes         String?
  userId        String?        @unique // acceso a la plataforma (empleado o repartidor)
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  punches           Punch[]
  justifications    Justification[]
  employeeDocuments EmployeeDocument[]
  payroll           PayrollReceipt[]

  @@index([status])
}

// Checadas (ZKTeco u otras fuentes).
model Punch {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  at         DateTime
  kind       String? // entrada, salida_comida, regreso_comida, salida (si el reloj lo manda)
  device     String?
  method     String?
  source     String   @default("import")
  externalId String?  @unique // UUID de la checada en la hoja
  createdAt  DateTime @default(now())

  @@unique([employeeId, at])
  @@index([at])
}

// Días justificados (vacaciones, incapacidad, permiso, día festivo para todos…).
model Justification {
  id          String    @id @default(cuid())
  date        DateTime  @db.Date
  employeeId  String? // vacío = todos
  employee    Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reason      String
  note        String?
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([date])
}

// ── Flotilla [A24] (misma estructura que la app actual: Vehiculos, Checks, Combustible,
// Fallas, Reparaciones, Documentos). Independiente de la app actual.

enum VehicleStatus {
  ACTIVO
  TALLER
  BAJA
}

model Vehicle {
  id        String        @id @default(cuid())
  code      String        @unique // M-01 (va en el QR)
  plate     String?
  brand     String?
  model     String?
  year      Int?
  color     String?
  vin       String?
  km        Int           @default(0)
  size      String        @default("grande") // chica: solo CDMX, sin carreteras ni cerros
  ownership String        @default("empresa") // empresa | propia
  ownerId   String? // empleado dueño si es moto propia
  status    VehicleStatus @default(ACTIVO)
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  documents VehicleDocument[]
  checks    VehicleCheck[]
  fuel      FuelLoad[]
  faults    Fault[]
  repairs   Repair[]
}

model VehicleDocument {
  id          String    @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type        String // tarjeta_circulacion, seguro, verificacion, permiso, refrendo…
  folio       String?
  issuedAt    DateTime? @db.Date
  expiresAt   DateTime? @db.Date
  evidenceKey String?
  updatedById String?
  updatedAt   DateTime  @updatedAt

  @@unique([vehicleId, type])
}

enum CheckKind {
  MATUTINO // al recibir la moto: 4 fotos + odómetro + km
  ANTES_RUTA // antes de salir: daños que no se reportaron en la mañana
}

model VehicleCheck {
  id          String    @id @default(cuid())
  kind        CheckKind
  vehicleId   String
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id])
  employeeId  String
  at          DateTime  @default(now())
  km          Int?
  kmDriven    Int? // desde el check matutino anterior de esa moto (se le asigna a quien la traía)
  photos      String[]
  odometerKey String?
  description String?
  lat         Float?
  lng         Float?

  fuel   FuelLoad[]
  faults Fault[]

  @@index([vehicleId, at])
  @@index([employeeId, at])
}

model FuelLoad {
  id         String        @id @default(cuid())
  checkId    String?
  check      VehicleCheck? @relation(fields: [checkId], references: [id])
  vehicleId  String
  vehicle    Vehicle       @relation(fields: [vehicleId], references: [id])
  employeeId String
  at         DateTime      @default(now())
  amount     Decimal       @db.Decimal(10, 2)
  liters     Decimal?      @db.Decimal(8, 2)
  ticketKey  String?

  @@index([vehicleId, at])
}

enum FaultStatus {
  ABIERTA
  EN_REPARACION
  CERRADA
  DESCARTADA
}

model Fault {
  id            String        @id @default(cuid())
  kind          String        @default("reportada") // reportada | no_reportada (hallada antes de ruta)
  checkId       String?
  check         VehicleCheck? @relation(fields: [checkId], references: [id])
  vehicleId     String
  vehicle       Vehicle       @relation(fields: [vehicleId], references: [id])
  reportedById  String // empleado
  responsibleId String? // quien hizo el check matutino de esa moto
  description   String
  severity      String        @default("media") // baja | media | alta
  photos        String[]
  status        FaultStatus   @default(ABIERTA)
  mechanicNote  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  repair Repair?

  @@index([status, createdAt])
}

model Repair {
  id             String    @id @default(cuid())
  faultId        String?   @unique
  fault          Fault?    @relation(fields: [faultId], references: [id])
  vehicleId      String
  vehicle        Vehicle   @relation(fields: [vehicleId], references: [id])
  mechanicUserId String?
  startedAt      DateTime  @default(now())
  closedAt       DateTime?
  description    String?
  photos         String[]
  partsCost      Decimal   @default(0) @db.Decimal(10, 2)
  laborCost      Decimal   @default(0) @db.Decimal(10, 2)
  cause          String? // desgaste | mal_uso | ambos
  responsibleId  String? // empleado
  employeeAmount Decimal   @default(0) @db.Decimal(10, 2)
  companyAmount  Decimal   @default(0) @db.Decimal(10, 2)

  charge EmployeeCharge?

  @@index([closedAt])
}

// Adeudos de empleados (p. ej. reparación por mal uso). Base para descuentos de nómina.
model EmployeeCharge {
  id          String       @id @default(cuid())
  employeeId  String
  amount      Decimal      @db.Decimal(10, 2)
  description String
  repairId    String?      @unique
  repair      Repair?      @relation(fields: [repairId], references: [id])
  createdById String?
  createdAt   DateTime     @default(now())
  payrollLine PayrollLine?

  @@index([employeeId, createdAt])
}

// ── Altas y expedientes [A22, A25] (mismas pestañas del portal actual: DocsTipos,
// DocsEmpleado, Altas, Apps). Independiente del portal actual.

model DocType {
  key         String  @id // ine_frente, curp, licencia…
  name        String
  description String?
  positions   String  @default("todos") // todos | repartidor | lista separada por comas
  required    Boolean @default(true)
  order       Int     @default(100)
  active      Boolean @default(true)
}

enum DocStatus {
  PENDIENTE
  APROBADO
  RECHAZADO
}

model EmployeeDocument {
  id            String           @id @default(cuid())
  employeeId    String?
  employee      Employee?        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  applicationId String?
  application   HireApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  docType       String
  fileKey       String
  fileName      String?
  mime          String
  status        DocStatus        @default(PENDIENTE)
  comment       String?
  reviewedById  String?
  reviewedAt    DateTime?
  uploadedAt    DateTime         @default(now())

  @@index([employeeId, docType])
  @@index([applicationId])
}

enum HireStatus {
  EN_PROCESO // la persona está llenando
  ENVIADA // terminó; falta revisión
  APROBADA // ya es empleado
  RECHAZADA
}

model HireApplication {
  id                String     @id @default(cuid())
  tokenHash         String     @unique
  status            HireStatus @default(EN_PROCESO)
  role              String     @default("repartidor") // repartidor | oficina | bodega | mecanico…
  name              String?
  rfc               String?
  curp              String?
  nss               String?
  phone             String?
  email             String?
  address           String?
  clabe             String?
  bank              String?
  emergencyName     String?
  emergencyPhone    String?
  emergencyRelation String?
  notes             String?
  employeeId        String?    @unique
  resolvedById      String?
  resolvedAt        DateTime?
  submittedAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  documents EmployeeDocument[]

  @@index([status, createdAt])
}

model OnboardingApp {
  key         String  @id
  name        String
  description String?
  icon        String?
  kind        String // playstore | apk | web
  installUrl  String?
  openUrl     String?
  positions   String  @default("todos")
  required    Boolean @default(true)
  order       Int     @default(100)
  active      Boolean @default(true)
}

// Trabajos de sincronización con MercadoLibre [I01, A12]: notificaciones y envíos escaneados.
// Una fila por recurso (clave única); una notificación nueva la vuelve a poner pendiente.
enum MlJobStatus {
  PENDING
  DONE
  FAILED
}

model MlJob {
  id        String      @id @default(cuid())
  key       String      @unique // "shipment:48341193826"
  topic     String // shipments | orders
  resource  String // /shipments/48341193826
  mlUserId  BigInt?
  status    MlJobStatus @default(PENDING)
  attempts  Int         @default(0)
  lastError String?
  runAfter  DateTime    @default(now())
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status, runAfter])
}

// Recibos de nómina quincenales [A25, A26]. Recibo virtual: no sustituye al CFDI timbrado.
enum PayrollStatus {
  BORRADOR
  APROBADO
  PAGADO
}

enum PayrollLineKind {
  PERCEPCION
  DEDUCCION
}

model PayrollReceipt {
  id          String        @id @default(cuid())
  employeeId  String
  employee    Employee      @relation(fields: [employeeId], references: [id])
  quincena    String // "2026-10-2"
  periodFrom  DateTime      @db.Date
  periodTo    DateTime      @db.Date
  dailySalary Decimal       @db.Decimal(10, 2)
  status      PayrollStatus @default(BORRADOR)
  approvedAt  DateTime?
  paidAt      DateTime?
  paymentRef  String?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  lines       PayrollLine[]

  @@unique([employeeId, quincena])
  @@index([quincena])
}

model PayrollLine {
  id        String          @id @default(cuid())
  receiptId String
  receipt   PayrollReceipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  kind      PayrollLineKind
  concept   String
  amount    Decimal         @db.Decimal(10, 2)
  auto      Boolean         @default(false) // calculada (sueldo, faltas, adeudo); se recalcula en borrador
  chargeId  String?         @unique // adeudo descontado aquí (una sola vez)
  charge    EmployeeCharge? @relation(fields: [chargeId], references: [id])
  order     Int             @default(0)
}

// Suscripciones a notificaciones push del navegador/teléfono [P05].
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// API para clientes grandes [I08]: llaves por cliente (solo se guarda el hash) y webhooks de estado.
model ApiKey {
  id         String    @id @default(cuid())
  clientId   String
  client     Client    @relation(fields: [clientId], references: [id])
  name       String
  prefix     String // primeros caracteres, para reconocerla
  hash       String    @unique // sha256 de la llave completa
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([clientId])
}

model WebhookEndpoint {
  id         String            @id @default(cuid())
  clientId   String            @unique
  client     Client            @relation(fields: [clientId], references: [id])
  url        String
  secret     String // cifrado con ENCRYPTION_KEY
  active     Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  deliveries WebhookDelivery[]
}

enum WebhookStatus {
  PENDING
  SENT
  FAILED
}

model WebhookDelivery {
  id            String          @id @default(cuid())
  endpointId    String
  endpoint      WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  orderId       String
  event         String
  payload       Json
  status        WebhookStatus   @default(PENDING)
  attempts      Int             @default(0)
  nextAttemptAt DateTime        @default(now())
  lastError     String?
  responseCode  Int?
  createdAt     DateTime        @default(now())
  sentAt        DateTime?

  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
}

// Tiendas en línea del cliente [I06]: sus pedidos pagados entran como envíos por webhook.
enum StorePlatform {
  WOOCOMMERCE
  SHOPIFY
}

model StoreConnector {
  id          String        @id @default(cuid())
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id])
  platform    StorePlatform
  name        String
  secret      String // cifrado; Woo: lo generamos; Shopify: lo pega el cliente
  branchId    String?
  active      Boolean       @default(true)
  received    Int           @default(0)
  created     Int           @default(0)
  lastAt      DateTime?
  lastResult  String?
  createdAt   DateTime      @default(now())

  @@index([clientId])
}
