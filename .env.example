# Copia este archivo como apps/web/.env.local y packages/db/.env para desarrollo.
DATABASE_URL="postgresql://packatelas:packatelas@localhost:5432/packatelas?schema=public"
REDIS_URL="redis://localhost:6379"
# 32 bytes en base64 para cifrar tokens de ML y llaves de terceros: openssl rand -base64 32
ENCRYPTION_KEY=""
# Google Places API (New) para sugerencias de dirección. Vacío = OpenStreetMap gratuito.
GOOGLE_MAPS_API_KEY=""
# Carpeta para fotos de evidencia (después: Object Storage)
UPLOAD_DIR="./uploads"
# Lectura de depósitos de Fondeadora en Gmail (ver docs/DESPLIEGUE.md, sección Gmail)
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
# Dirección pública del sistema, para los enlaces de seguimiento que se mandan por WhatsApp
PUBLIC_URL="https://admin.packatelas.mx"
# WhatsApp Cloud API (Meta): token permanente de usuario del sistema y Phone number ID
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""

# Mercado Pago (pago de saldo con tarjeta)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
